# syntax=docker/dockerfile:1

# =============================================================================
# Presidio Analyzer on Chainguard/Wolfi
#
# Design notes for reviewers:
#   * Upstream's pyproject.toml + uv.lock are the dependency source of truth,
#     but they are re-locked here for two packages with known advisories.
#   * Security floors live in constraints.txt and are enforced through
#     PIP_CONSTRAINT / UV_CONSTRAINT so that *nested* resolvers obey them —
#     notably the pip that spacy.cli.download spawns.
#   * The build FAILS if the floors are not met in the final venv. A pin that
#     silently doesn't apply is worse than no pin at all.
# =============================================================================


# --- uv, pinned ---------------------------------------------------------------
# Pinning the resolver makes the build reproducible and removes the assumption
# that the Chainguard dev image ships a particular uv version.
# TODO: replace `latest` with an explicit tag (e.g. 0.9.5) before merging.
FROM ghcr.io/astral-sh/uv:latest AS uv


# --- Upstream: source of app code, config, and the locked dependency set ------
# None of its OS layers (Debian, perl-base, apt, ...) reach the final image.
FROM ghcr.io/data-privacy-stack/presidio-analyzer:2.2.364 AS upstream


# --- Build --------------------------------------------------------------------
FROM cgr.dev/chainguard/python:latest-dev AS build

USER root
WORKDIR /app

COPY --from=uv /uv /uvx /usr/local/bin/

ARG NLP_CONF_FILE=presidio_analyzer/conf/default.yaml
ARG ANALYZER_CONF_FILE=presidio_analyzer/conf/default_analyzer.yaml
ARG RECOGNIZER_REGISTRY_CONF_FILE=presidio_analyzer/conf/default_recognizers.yaml

# constraints.txt must be in place BEFORE any resolver runs, and PIP_CONSTRAINT
# must stay set for the whole stage — install_nlp_models.py invokes pip
# indirectly and would otherwise be free to reintroduce a vulnerable version.
COPY constraints.txt /app/constraints.txt

ENV PIP_NO_CACHE_DIR=1 \
    PIP_CONSTRAINT=/app/constraints.txt \
    UV_CONSTRAINT=/app/constraints.txt \
    UV_PROJECT_ENVIRONMENT=/app/venv \
    VIRTUAL_ENV=/app/venv \
    NLP_CONF_FILE=${NLP_CONF_FILE} \
    ANALYZER_CONF_FILE=${ANALYZER_CONF_FILE} \
    RECOGNIZER_REGISTRY_CONF_FILE=${RECOGNIZER_REGISTRY_CONF_FILE}

COPY --from=upstream /app/pyproject.toml /app/uv.lock ./

# Re-resolve only the two advisory packages, then assert the lock is consistent
# with pyproject.toml before installing.
#
# --upgrade-package raises each package to the newest version its dependents
# permit. If a dependent *caps* one of them below the floor, the verification
# gate further down fails the build — which is the correct outcome. Fix it by
# bumping the capping dependency, not by force-installing over the top.
#
# If you need a hard declarative floor at resolve time rather than a nudge, add
# to pyproject.toml instead:
#     [tool.uv]
#     constraint-dependencies = ["setuptools>=78.1.1", "msgpack>=1.2.1"]
RUN uv lock --upgrade-package setuptools --upgrade-package msgpack \
 && uv sync --locked --no-cache --no-default-groups --extra server --no-install-project

# --- spaCy model download -----------------------------------------------------
# This step runs pip inside /app/venv via spacy.cli.download. PIP_CONSTRAINT
# above is what keeps it from walking the floors back.
COPY --from=upstream /app/${NLP_CONF_FILE} ./${NLP_CONF_FILE}
COPY --from=upstream /app/${ANALYZER_CONF_FILE} ./${ANALYZER_CONF_FILE}
COPY --from=upstream /app/${RECOGNIZER_REGISTRY_CONF_FILE} ./${RECOGNIZER_REGISTRY_CONF_FILE}
COPY --from=upstream /app/install_nlp_models.py ./

RUN /app/venv/bin/python install_nlp_models.py \
    --nlp_conf_file ${NLP_CONF_FILE} \
    --analyzer_conf_file ${ANALYZER_CONF_FILE}

# --- Gate: fail the build if the venv does not meet the advisory floors -------
# Runs LAST, after every step that can mutate site-packages. Also writes a
# manifest of exactly what shipped, for correlating against scanner output.
RUN /app/venv/bin/python - <<'PY'
import re
import sys
from importlib.metadata import distributions

FLOORS = {
    "setuptools": ("78.1.1", "CVE-2025-47273"),
    "msgpack": ("1.2.1", "GHSA-6v7p-g79w-8964"),
}


def as_tuple(version):
    """Coarse numeric compare. Adequate for simple X.Y.Z advisory floors."""
    return tuple(int(part) for part in re.findall(r"\d+", version)[:3])


installed = {}
for dist in distributions():
    name = (dist.metadata["Name"] or "").lower().replace("_", "-")
    if name:
        installed[name] = dist.version

failures = []
print("Advisory floor check:")
for package, (floor, advisory) in FLOORS.items():
    found = installed.get(package)
    if found is None:
        print(f"  {package:<12} absent — nothing to patch ({advisory})")
        continue
    ok = as_tuple(found) >= as_tuple(floor)
    print(f"  {package:<12} {found:<10} floor {floor:<10} "
          f"{'OK' if ok else 'FAIL'}  {advisory}")
    if not ok:
        failures.append(f"{package}=={found} is below {floor} ({advisory})")

if failures:
    sys.exit("BUILD FAILED — advisory floors not met:\n  " + "\n  ".join(failures))

print("All advisory floors satisfied.")
PY

RUN uv pip freeze --python /app/venv/bin/python > /app/venv-manifest.txt


# --- Runtime: minimal Wolfi image — no shell, no package manager --------------
FROM cgr.dev/chainguard/python:latest

WORKDIR /app

COPY --from=build /app/venv /app/venv
COPY --from=build /app/venv-manifest.txt /app/venv-manifest.txt
COPY --from=upstream /app/app.py /app/logging.ini ./
COPY --from=upstream /app/presidio_analyzer ./presidio_analyzer

ENV PATH="/app/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    GUNICORN_CMD_ARGS="--workers 1 --bind 0.0.0.0:3000"

EXPOSE 3000

USER nonroot

HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:3000/health', timeout=2)"]

ENTRYPOINT ["gunicorn", "app:create_app()"]

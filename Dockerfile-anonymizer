# syntax=docker/dockerfile:1

# Used only as a source for the exact app code and pinned dependency
# versions Presidio ships at 2.2.364 — none of its OS layers (Debian,
# perl-base, apt, etc.) end up in the final image.
FROM ghcr.io/data-privacy-stack/presidio-anonymizer:2.2.364 AS upstream

# --- Build: resolve the same locked deps fresh against Chainguard's Python/Wolfi ---
FROM cgr.dev/chainguard/python:latest-dev AS build

USER root

WORKDIR /app

ENV PIP_NO_CACHE_DIR=1 \
    UV_PROJECT_ENVIRONMENT=/app/venv

COPY --from=upstream /app/pyproject.toml /app/uv.lock ./

# --locked installs exactly what Presidio's own lockfile pins; the
# follow-up upgrade patches cryptography past Presidio's own
# `<49.0.0` cap, which predates the fixes for CVE-2026-69249
# (path-building DoS, fixed 49.0.0) and CVE-2026-69247 (PKCS#7
# Bleichenbacher oracle, fixed 50.0.0).
RUN uv sync --locked --no-cache --no-default-groups --extra server --no-install-project \
    && uv pip install --no-cache "cryptography>=50.0.0"

# --- Runtime: minimal Chainguard/Wolfi image — no shell, no package manager ---
FROM cgr.dev/chainguard/python:latest

WORKDIR /app

COPY --from=build /app/venv /app/venv
COPY --from=upstream /app/app.py /app/logging.ini ./
COPY --from=upstream /app/presidio_anonymizer ./presidio_anonymizer

ENV PATH="/app/venv/bin:$PATH" \
    GUNICORN_CMD_ARGS="--workers 1 --bind 0.0.0.0:3000"

EXPOSE 3000

USER nonroot

HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:3000/health', timeout=2)"]

ENTRYPOINT ["gunicorn", "app:create_app()"]
